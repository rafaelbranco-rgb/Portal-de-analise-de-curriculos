GEMINI_API_KEY=cole_sua_chave_do_google_ai_studio_aqui
GEMINI_MODEL=gemini-2.5-pro
FLASK_PORT=5000
# Token de segurança do endpoint /api/triagem (usado pelo n8n no header
# X-API-Key). Gere uma string aleatória longa e use a MESMA no n8n.
TRIAGEM_API_KEY=

# --- Triagem automática DIRETA do Monday (sem n8n): /api/monday-webhook ---
# Token de API do monday.com (conta com acesso ao board de Recrutamento).
MONDAY_API_TOKEN=
# Token aleatório exigido na query string do webhook (?token=...).
MONDAY_WEBHOOK_TOKEN=
# Etiquetas (labels) exatas da coluna "Avaliação de Currículo".
TRIAGEM_LABEL_APROVADO=APROV.ENTREVISTA
TRIAGEM_LABEL_REPROVADO=REPROV.TRIAGEM
# Nota de corte e se reprova automaticamente quem ficar abaixo dela.
TRIAGEM_THRESHOLD=7.0
TRIAGEM_REPROVAR=1
# String de conexão do Postgres. Ex.:
#   postgresql://usuario:senha@host:porta/banco?sslmode=require
# Use sslmode=disable se o servidor NÃO aceitar SSL.
DATABASE_URL=

# --- Login do portal (acesso restrito) ---
# Chave que assina o cookie de sessão. Gere uma string aleatória longa e NÃO
# troque depois (trocar desconecta todo mundo). Sem ela, o portal deriva uma
# chave a partir dos outros segredos — funciona, mas é menos previsível.
SECRET_KEY=
# Primeiro usuário: só é criado enquanto não existir NENHUM usuário no banco.
# Depois do primeiro login, cadastre as outras pessoas em Opções → Acesso e
# usuários e remova estas duas variáveis.
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_SENHA=
PORTAL_ADMIN_NOME=
