GEMINI_API_KEY=cole_sua_chave_do_google_ai_studio_aqui
GEMINI_MODEL=gemini-2.5-pro
FLASK_PORT=5000
# Token de segurança do endpoint /api/triagem (usado pelo n8n no header
# X-API-Key). Gere uma string aleatória longa e use a MESMA no n8n.
TRIAGEM_API_KEY=
# String de conexão do Postgres. Ex.:
#   postgresql://usuario:senha@host:porta/banco?sslmode=require
# Use sslmode=disable se o servidor NÃO aceitar SSL.
DATABASE_URL=
